# summary: grlc get-ao-for-mie: adverse outcomes of the AOPs a molecular initiating event starts
# param: mie iri
PREFIX aopo: <http://aopkb.org/aop_ontology#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
SELECT ?MIE ?MolecularInitiatingEventName ?AOwebpage ?AdverseOutcomeName
FROM <urn:aopwiki:graph>
WHERE {
  VALUES ?MIE { ?__mie }
  ?MIE dc:title ?MolecularInitiatingEventName .
  ?AOPwebpage a aopo:AdverseOutcomePathway ;
    aopo:has_molecular_initiating_event ?MIE ;
    aopo:has_adverse_outcome ?AOwebpage .
  ?AOwebpage dc:title ?AdverseOutcomeName .
}
