# summary: grlc get-stressors-for-ao (literal): stressors and chemicals for AOs whose name contains the text
# (fixed: case-insensitive substring instead of a regex over user input)
# param: text literal
PREFIX aopo: <http://aopkb.org/aop_ontology#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX nci: <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#>
SELECT ?AO ?AOname ?StressorName ?ChemicalName
FROM <urn:aopwiki:graph>
WHERE {
  ?AO a aopo:KeyEvent ;
    dc:title ?AOname .
  ?AOP a aopo:AdverseOutcomePathway ;
    aopo:has_adverse_outcome ?AO ;
    nci:C54571 ?Stressor .
  ?Stressor dc:title ?StressorName .
  OPTIONAL {
    ?Stressor aopo:has_chemical_entity ?Chemical .
    ?Chemical dc:title ?ChemicalName .
  }
  FILTER(CONTAINS(LCASE(STR(?AOname)), ?__text))
}
ORDER BY DESC(?AO)
