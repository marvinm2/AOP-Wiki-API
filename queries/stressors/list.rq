# summary: Page of stressors matching the filters, ordered by stressor number
# param: limit int
# param: offset int
PREFIX aopo: <http://aopkb.org/aop_ontology#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX nci: <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?stressor (xsd:integer(STRAFTER(STR(?stressor), "/aop.stressor/")) AS ?number)
FROM <urn:aopwiki:graph>
WHERE {
  ?stressor a nci:C54571 .
  # include: stressors/_filters
}
ORDER BY ?number
LIMIT ?__limit
OFFSET ?__offset
