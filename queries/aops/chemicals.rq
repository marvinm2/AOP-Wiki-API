# summary: Chemicals of the stressors associated with one AOP
# param: aop iri
PREFIX aopo: <http://aopkb.org/aop_ontology#>
PREFIX cheminf: <http://semanticscience.org/resource/CHEMINF_>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX nci: <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#>
SELECT DISTINCT ?chemical ?cas ?title ?inchikey ?stressor
FROM <urn:aopwiki:graph>
WHERE {
  ?__aop nci:C54571 ?stressor .
  ?stressor aopo:has_chemical_entity ?chemical .
  OPTIONAL { ?chemical cheminf:000446 ?cas }
  OPTIONAL { ?chemical dc:title ?title }
  OPTIONAL { ?chemical cheminf:000059 ?inchikey }
}
