# summary: Page of AOPs matching the filters, ordered by AOP number
# param: limit int
# param: offset int
PREFIX aopo: <http://aopkb.org/aop_ontology#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX nci: <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#>
PREFIX ncbitaxon: <http://purl.bioontology.org/ontology/NCBITAXON/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?aop (xsd:integer(STRAFTER(STR(?aop), "/aop/")) AS ?number)
FROM <urn:aopwiki:graph>
WHERE {
  ?aop a aopo:AdverseOutcomePathway .
  # include: aops/_filters
}
ORDER BY ?number
LIMIT ?__limit
OFFSET ?__offset
